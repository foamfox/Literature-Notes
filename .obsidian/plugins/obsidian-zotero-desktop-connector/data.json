    },
    {
      "name": "Import Review Paper",
      "outputPathTemplate": "01-Literature-Notes/Unread/{{citekey}}.md",
      "imageOutputPathTemplate": "05-Assets/{{citekey}}/",
      "imageBaseNameTemplate": "image",
      "templatePath": "99-Templates/01b-literature-note-review-template.md",
      "cslStyle": "ieee-with-url"
    },
    {
      "name": "Import Research Paper",
      "outputPathTemplate": "01-Literature-Notes/Unread/{{citekey}}.md",
      "imageOutputPathTemplate": "05-Assets/{{citekey}}/",
      "imageBaseNameTemplate": "image",
